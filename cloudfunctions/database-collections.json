        "version": 1
      },
      {
        "_id": "channel_policy",
        "channels": {
          "merchant": {
            "publicVisible": true,
            "submissionEnabled": true,
            "adminPublishingEnabled": true
          },
          "rental": {
            "publicVisible": true,
            "submissionEnabled": true,
            "adminPublishingEnabled": true
          },
          "job": {
            "publicVisible": false,
            "submissionEnabled": false,
            "adminPublishingEnabled": false
          }
        },
        "version": 1
      }
